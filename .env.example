DEEPSEEK_API_KEY=
QUERY_DATABASE_URL=postgresql://sqlagent_reader:sqlagent_reader@localhost:5433/sqlagent
INDEX_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sqlagent
MAX_CONCURRENT_REQUESTS=8
DB_POOL_SIZE=8
REQUEST_TIMEOUT_SECONDS=90
MAX_TOOL_CALLS=6
MAX_REPAIRS=2
MAX_TOTAL_TOKENS=12000
MAX_OUTPUT_TOKENS=1024
HF_LOCAL_FILES_ONLY=1
# Docker model cache: set to an existing Hugging Face cache directory.
HF_CACHE_DIR=./.hf-cache

# V2.2 sessions; empty API_CLIENT_KEYS means local single-user mode.
API_CLIENT_KEYS={}
SESSION_DATABASE_PATH=.data/sessions.sqlite
SESSION_TTL_SECONDS=1800
MAX_SESSIONS=1000
MAX_HISTORY_TURNS=8
CLI_SESSION_DATABASE_PATH=.data/cli-sessions.sqlite
